# Local development only - template; copy to `.env` and fill in real values.
# This file is checked in, but the actual `.env` is gitignored and should
# never be committed. Keep the values here NON-sensitive placeholders.
#
# Both Docker Compose (variable substitution) and
# `pnpm knowledge:graph:sync` (node --env-file-if-exists=.env) read these
# three variables from `.env`.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me